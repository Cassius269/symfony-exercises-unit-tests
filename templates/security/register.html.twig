{% extends 'base.html.twig' %}

{% block title %}Page d'inscription
{% endblock %}
{% block body %}
	<h1>Inscription</h1>
	<section>
		{{ form_start(form) }}
		{{ form_errors(form) }}

		<div class="row">
			<div class="col">{{ form_row(form.firstname) }}</div>
			<div class="col">{{ form_row(form.lastname) }}</div>
		</div>

		{{ form_row(form.email) }}
		{{ form_rest(form) }}
		{{ form_end(form) }}
	</section>
{% endblock %}
